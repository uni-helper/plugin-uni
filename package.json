{
  "name": "@uni-helper/plugin-uni",
  "type": "module",
  "version": "0.1.2",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "warn"
    }
  },
  "description": "uni-app plugin 的 ESM 导出",
  "author": "FliPPeDround <flippedround@qq.com>",
  "license": "MIT",
  "funding": "https://afdian.com/a/flippedround",
  "homepage": "https://github.com/uni-helper/plugin-uni#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/plugin-uni.git"
  },
  "bugs": {
    "url": "https://github.com/uni-helper/plugin-uni/issues"
  },
  "keywords": [
    "uni-app",
    "uni-helper",
    "vite",
    "vite-plugin",
    "ESM"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "type": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.cjs"
    },
    "./*": "./*"
  },
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./*"
      ]
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "play:mp-weixin": "pnpm -C playground run dev:mp-weixin",
    "build:mp-weixin": "pnpm -C playground run build:mp-weixin",
    "play:h5": "pnpm -C playground run dev:h5",
    "build:h5": "pnpm -C playground run build:h5",
    "release": "bumpp",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "peerDependencies": {
    "@dcloudio/vite-plugin-uni": "*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@dcloudio/vite-plugin-uni": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "vite": "catalog:"
  }
}
